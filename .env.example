# Server-only secrets for the single owner door.
# Set these in Vercel. Never commit real values.
# Do not prefix them with NEXT_PUBLIC_.

# The one account that can enter. Matched case-insensitively.
DEN_OWNER_EMAIL=

# Passphrase for that account. At least 10 characters.
# Stored encrypted by Vercel. Use a long, unique passphrase.
DEN_OWNER_PASSWORD=

# HMAC key for the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
