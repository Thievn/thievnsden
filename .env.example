# Server-only values. Never prefix these with NEXT_PUBLIC_.
# Never commit real values.

# The one account that can sign in. Matched case-insensitively. Must include @.
DEN_OWNER_EMAIL=

# Signed-in name, and another way to sign in.
# Matched case-insensitively. Not a secret. Example: Thievn
DEN_OWNER_USERNAME=

# The password itself, at least 10 characters. Not a hash.
DEN_OWNER_PASSWORD=

# HMAC key for the session cookie. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public trading-wallet address. Not a secret, but the server returns it
# only after sign-in, and only if it is a 32-byte public key.
# A seed phrase or secret key is rejected and not logged.
DEN_WALLET_ADDRESS=

# Optional mainnet RPC. If unset, the server uses the public Solana RPC.
# A private URL can embed an API key, so treat it as a secret.
# The browser never receives it. Wallet transfers use the public cluster RPC.
# SOLANA_RPC_URL=

# Optional per-transfer sanity cap, in SOL. Default 2.
# Amounts above it are allowed only after the owner types CONFIRM.
# DEN_MAX_TRANSFER_SOL=2

# Already set on the Vercel project for production and preview.
# This app does not read it. Never prefix it with NEXT_PUBLIC_.
# XAI_API_KEY=

# Already set on the Vercel project. Server-only. Do not copy them into
# NEXT_PUBLIC_ variables. The anon key is not used.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Public half of the Web Push key pair. Safe to put on Vercel (preview, and
# production when alerts should work there). Not a secret. Never commit a real value.
# Generate a pair with: npx --yes web-push generate-vapid-keys
# The private key stays on the desk box. See DESK_NOTIFY.md.
# VAPID_PUBLIC_KEY=
